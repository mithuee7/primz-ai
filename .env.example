# ---------------------------------------------------------------
# Primz AI environment variables. Copy to .env.local and fill in.
# Only the three Supabase values are required. Groq and Instagram details
# are entered in the app (Settings) and stored encrypted in your database.
# ---------------------------------------------------------------

# Force demo mode (in-memory data, no Supabase). Demo mode is also used
# automatically whenever the Supabase variables below are missing.
DEMO_MODE=true

# Supabase (https://supabase.com/dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Fallback Groq key if you did not save one in Settings.
GROQ_API_KEY=
# Optional. Overrides the key used to encrypt saved secrets (default: derived from
# SUPABASE_SERVICE_ROLE_KEY). openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Output checker must report at least this confidence to approve a message.
CHECKER_MIN_CONFIDENCE=0.85

# --- Added: secrets read by the app ---
# Admin page (/admin). Admin is locked out if this is unset.
ADMIN_PASSWORD=
# Platform keys for the Free and Basic plans (comma separated, several keys rotate).
BASIC_GROQ_KEYS=
BASIC_APIFY_KEYS=
# Homepage demo (optional model override).
DEMO_GROQ_API_KEY=
DEMO_GROQ_MODEL=
